<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Catalogue sur GitHub Pages, medias HLS sur R2, et appels a
         api.anthropic.com pour la generation. Aucune autre destination. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- La generation d'une serie depasse largement la limite de ~10 minutes
         d'un Worker ordinaire : elle tourne en avant-plan avec une
         notification de progression. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.DramaForge"
        android:supportsRtl="true">

        <!-- Portrait verrouille : le format du produit est le 9:16 plein ecran.
             Un lecteur en paysage n'a pas de sens ici, donc les avertissements
             lint sur l'orientation fixe sont volontairement ignores. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager fait tourner la generation en avant-plan. Depuis
             Android 14, un service d'avant-plan doit declarer son type, sinon
             il echoue au demarrage. On complete donc la declaration fournie
             par la bibliotheque. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
