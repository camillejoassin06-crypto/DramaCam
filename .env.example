# Option A = zéro coût récurrent. Aucune clé d'API facturée à l'usage ici.
# La génération de texte passe par `claude -p` (abonnement Claude Code), jamais
# par l'API Anthropic directe. Il n'y a donc PAS d'ANTHROPIC_API_KEY.
#
# Ces valeurs vivent dans les GitHub Secrets du repo (Settings > Secrets).
# En local elles ne servent qu'à publish.ts et restent hors du dépôt (.env).
# Jamais dans l'APK.

# Cloudflare R2 (bucket public, offre gratuite 10 Go)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dramaforge-media
# Base publique servant les médias (domaine r2.dev ou domaine personnalisé)
R2_PUBLIC_BASE_URL=https://media.example-placeholder.dev

# Fournisseurs optionnels, tous gratuits
TTS_PROVIDER=edge-tts
IMAGE_PROVIDER=placeholder
# URL d'une instance ComfyUI locale si IMAGE_PROVIDER=local-sd
COMFYUI_URL=http://127.0.0.1:8188
